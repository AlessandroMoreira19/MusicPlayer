# ============================================================================
# CONFIGURAÇÃO DO FIREBASE (LEIA ANTES DE EXECUTAR O PROJETO)
# ============================================================================
# Este repositório NÃO inclui credenciais do Firebase.
# Para executar o projeto, crie o SEU próprio projeto no Firebase:
#
# 1. Acesse https://console.firebase.google.com/ e crie um novo projeto.
# 2. No menu "Criação (Build) -> Authentication":
#    - Ative o provedor de login "E-mail/senha".
# 3. No menu "Criação (Build) -> Realtime Database":
#    - Crie o banco de dados.
#    - Na aba "Regras" (Rules), cole as regras abaixo para restringir leitura
#      e escrita apenas ao próprio usuário autenticado:
#
#    {
#      "rules": {
#        "users": {
#          "$uid": {
#            ".read": "auth != null && auth.uid === $uid",
#            ".write": "auth != null && auth.uid === $uid"
#          }
#        }
#      }
#    }
#
# 4. Em "Configurações do projeto -> Seus aplicativos", adicione um app Web (</>)
#    para copiar as chaves do objeto firebaseConfig.
# 5. Copie este arquivo para ".env" na raiz do projeto (copy .env.example .env)
#    e substitua os valores abaixo pelas suas chaves (sem aspas e sem ";").
#    Obs.: Nunca envie o arquivo ".env" para o GitHub (já ignorado no .gitignore).
#    As variáveis EXPO_PUBLIC_* são incorporadas ao aplicativo e não são segredos;
#    nunca coloque senhas administrativas, chaves privadas ou credenciais de servidor.
# ============================================================================

EXPO_PUBLIC_FIREBASE_API_KEY=sua_api_key_aqui
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://seu_projeto-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu_projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu_projeto.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=seu_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=seu_app_id
