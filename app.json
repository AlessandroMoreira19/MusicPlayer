{
  "expo": {
    "name": "MusicPlayer",
    "slug": "musicplayer-nyx",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/mascote_fones.png",
    "splash": {
      "image": "./assets/mascote_voando.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F17"
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/mascote_fones.png",
        "backgroundColor": "#1B1B29"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.fei.musicplayer"
    },
    "plugins": [
      ["expo-audio", { "recordAudioAndroid": false, "enableBackgroundPlayback": true }]
    ],
    "extra": {
      "eas": {
        "projectId": "3f5d90a9-d36a-4ce6-93e1-f44f893b11a1"
      }
    }
  }
}
